FROM node:22-bookworm-slim AS base
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-workspace.yaml tsconfig.base.json tsconfig.json ./
COPY apps/mcp/package.json apps/mcp/package.json
COPY packages/catalog-core/package.json packages/catalog-core/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/telemetry/package.json packages/telemetry/package.json
RUN pnpm install --frozen-lockfile=false
COPY . .
RUN pnpm --filter @nexo/contracts build && pnpm --filter @nexo/catalog-core build && pnpm --filter @nexo/telemetry build && pnpm --filter @nexo/mcp build
EXPOSE 8090
CMD ["pnpm", "--filter", "@nexo/mcp", "start"]
